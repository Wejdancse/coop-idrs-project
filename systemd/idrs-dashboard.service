[Unit]
Description=IDRS Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wejdan
WorkingDirectory=/home/wejdan/idrs/scripts
ExecStart=/home/wejdan/idrs/venv/bin/streamlit run dashboard.py --server.address 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
